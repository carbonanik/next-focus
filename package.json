{
  "name": "nextfocus-monorepo",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "python3 -m http.server 8000 --directory .",
    "dev:api": "cd apps/api && python3 -m uvicorn app.main:app --reload --port 8000",
    "check": "npm run check:js && npm run check:api",
    "check:js": "node scripts/check-js.mjs apps/extension",
    "check:api": "python3 -m compileall -q apps/api/app",
    "verify": "npm run check"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
